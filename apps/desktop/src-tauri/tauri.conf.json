{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "See",
  "version": "0.1.0",
  "identifier": "app.see.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -w @see/web",
    "devUrl": "http://localhost:5173/app",
    "beforeBuildCommand": "npm run build -w @see/web",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "See",
        "url": "/app",
        "width": 1440,
        "height": 900,
        "minWidth": 840,
        "minHeight": 560,
        "backgroundColor": "#0B0F0E",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Entertainment",
    "shortDescription": "Lists of anything, in your order.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
