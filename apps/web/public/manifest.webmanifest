{
  "name": "See",
  "short_name": "See",
  "description": "Lists of anything, in your order.",
  "start_url": "app",
  "scope": ".",
  "display": "standalone",
  "background_color": "#0B0F0E",
  "theme_color": "#0B0F0E",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+see",
      "url": "open?link=%s"
    }
  ]
}
